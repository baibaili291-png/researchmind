# 注意：本文件需要复制到**项目根目录**并命名为 .env 才会生效。
#   部署/运行时：cp deploy/.env.example .env
# 程序启动时会读取项目根目录的 .env（零依赖解析，无需 python-dotenv）；
# 同名的真实环境变量优先级更高。
#
# 配置后自检：访问 /mode，看 search_engines 的真实顺序，再跑一次研究，
# 报告"数据来源说明"里的检索引擎应显示 web:<引擎名>。
# 注意 deepseek_search_configured 只在配了 DeepSeek 官方平台 key 时才为 true
# （见下方"LLM key 与检索 key 是两件事"）。

# 关于"零 key"：代码不依赖付费 key 即可运行，靠免费引擎实测（2026-11-20，本机网络）：
#   - 搜狗：单次 400-500 KB 真实结果页、直链；约 1-4 次查询后出验证码
#   - 百度：时好时坏，连续请求后返回约 2.6 KB 反爬桩页
#   - so.com：约 4 次查询后出验证页并熔断 60 秒
#   - Bing 网页/RSS：对同一 IP 返回固定的降级结果（与查询无关，会被相关性闸门丢弃）
#   - Google / DuckDuckGo / jina Reader：被出站代理阻断（502）
# 结论：免费通道能覆盖一半左右的维度（实测 7 维度计划里 3/7 → 加入搜狗后 6/7），
# 但撑不起稳定完整的研究；要稳定产出请配 DeepSeek 官方或 Tavily 的 key。

# ========== 真实联网研究（默认开启） ==========
# 关闭后回退到内置离线资料库，仅用于离线演示与单元测试。
RESEARCHMIND_USE_WEB=true

# ========== LLM（可选，提升质量） ==========
# 不配置也能跑：规划用维度模板，抽取用确定性打分，写作用确定性渲染。
# 配置后由模型负责子问题拆解、事实抽取与报告撰写（任何 OpenAI 兼容端点）。
#
# 【关键】LLM key 与检索 key 是两件事，代码不再默认互相借用。
#   实测（2026-11-20）：一个 OpenAI 兼容网关的 key（base_url 形如
#   https://maas.xxx.com/compatible-mode/v1）对 /chat/completions 返回 200，
#   对 DeepSeek 的 /v1/tools/search、/v1/tools/fetch 返回 404——网关只代理
#   模型，不代理检索。旧版把 LLM key 无条件当检索 key 用，于是每次查询的第一个
#   引擎必然 404，既浪费时间又把真实故障掩盖成 "deepseek: 404"。
#   现在只有当 RESEARCHMIND_LLM_BASE_URL 指向 DeepSeek 官方域名时才借用，
#   否则必须在下面单独的 RESEARCHMIND_DEEPSEEK_API_KEY 里明确配置。
#
# 推理模型（如 deepseek-v4.1-flash）会先输出一大段 reasoning_content，
# max_tokens 给小了会返回 finish_reason=length + content 为空，
# 看起来就像"模型什么都没抽到"。默认给 4000。
RESEARCHMIND_LLM_API_KEY=
RESEARCHMIND_LLM_BASE_URL=https://api.deepseek.com/v1
RESEARCHMIND_LLM_MODEL=deepseek-chat
RESEARCHMIND_LLM_MAX_TOKENS=4000
# 是否允许调用真实外部服务。默认 true：key 为空时不会发起任何外部请求，
# 只有 key 存在才真正启用，因此无需为了"安全"把它关掉。
RESEARCHMIND_USE_LIVE_PROVIDERS=true

# ========== 搜索 ==========
# 引擎链顺序（/mode 会如实回报，不再有第二份手写副本）：
#   DeepSeek(有 key) -> Tavily(有 key) -> 搜狗 -> 百度 -> so.com -> Bing RSS -> Bing News。
# 任一引擎返回"与查询主题无关"的结果会被丢弃并继续试下一个，不会拿垃圾源凑数。
#
# 推荐：用 DeepSeek 原生 Search/Fetch（2026-10-17 开放，5 元/千次成功请求，
# 端点实测可达，QPS Search 100 / Fetch 25）。**必须填在下面这一项**，且该
# key 必须来自 DeepSeek 官方平台（api.deepseek.com），网关 key 无效：
RESEARCHMIND_DEEPSEEK_API_KEY=
# 其优势在于：自研引擎不像免费源那样按 IP 限流或返回降级结果；返回的
# summary 是 600-800 字长摘要（含完整句与数字）；Fetch 直接返回 Markdown
# 正文，绕过"页面需 JS 渲染/反爬"导致的抓取失败。
#
# Tavily 作为备选（免费额度约 1000 次/月，注册即用，无需付费）。
# 填在这里，检索走 Tavily，抓取在正文过短时自动回落到 Tavily Extract
# （因为本机的 reader 兜底 r.jina.ai 被出站代理阻断，Playwright 又是可选重装包）。
RESEARCHMIND_SEARCH_API_KEY=
RESEARCHMIND_SEARCH_BASE_URL=https://api.tavily.com
RESEARCHMIND_SEARCH_MAX_RESULTS=6

# ========== 配完自检（一条命令） ==========
#   python -m backend.tools.verify_keys
# 它会真实请求一次：LLM chat / DeepSeek Search+Fetch / Tavily Search+Extract /
# 免费引擎链，逐项打 OK 或 FAIL 并给出结论。不猜、不看 key 是否存在，
# 只看服务端怎么答——配错的 key 会直接显示服务端原文（如 401 invalid api key）。

# ========== 抓取 ==========
RESEARCHMIND_FETCH_TIMEOUT=15
RESEARCHMIND_MIN_BODY_CHARS=200
RESEARCHMIND_PLAYWRIGHT_FALLBACK=true
RESEARCHMIND_READER_API_FALLBACK=true
RESEARCHMIND_RESPECT_ROBOTS=true
RESEARCHMIND_DOMAIN_DELAY=1.0

# ========== 抽取（无 LLM 时的确定性打分） ==========
RESEARCHMIND_HEURISTIC_EXTRACT=true
RESEARCHMIND_MAX_FACTS_PER_DOC=5
RESEARCHMIND_FACT_MIN_SCORE=30

# ========== 缓存与限流 ==========
# 跨进程缓存搜索结果与已抓取正文，避免重复请求触发搜索引擎限流。
# 默认写在系统临时目录 researchmind_web_cache.json。
RESEARCHMIND_CACHE_DIR=

# ========== 存储 ==========
RESEARCHMIND_DATABASE_URL=sqlite+aiosqlite:///./researchmind.db
RESEARCHMIND_REDIS_URL=

# ========== 运行 ==========
RESEARCHMIND_LOG_LEVEL=INFO
